abel": "Email / SMS gateway", "color": "gray", "dashed": true, "icon": "builtin:mail"}, {"id": "console", "zone": "ops", "label": "Admin console", "icon": "builtin:settings"}, {"id": "mon", "zone": "ops", "label": "Prometheus\nmetrics, alerts", "icon": "logos/prometheus.svg"}, {"id": "cache", "zone": "data", "label": "Redis\ncart, sessions", "icon": "logos/redis.svg"}, {"id": "bus", "zone": "data", "label": "Apache Kafka\norder events", "icon": "logos/apachekafka.svg"}, {"id": "pg", "zone": "data", "label": "PostgreSQL\norders, stock", "icon": "logos/postgresql.svg"}], "edges": ["shopper->web: browse", {"edge": "shopper->mobile: use", "from_side": "left", "to_side": "left"}, "web->gw: HTTPS", "mobile->gw: HTTPS", "gw->orders: checkout", "gw->catalog: search", "orders->inventory: reserve", "orders->payments: charge", "payments->psp: authorize", "orders->pg: persist", "catalog->cache: cache", "orders->bus: OrderPlaced", "bus-->mail: notify", "console->gw: admin API", "mon-->pg: metrics"], "legend": {"blue": "Client side", "green": "Platform services", "purple": "Data and messaging", "orange": "Operations", "gray": "External / actors"}}, "base_dir": "C:\\Users\\rifqi\\AppData\\Local\\Temp\\claude\\D--00-Work\\70fbabe9-c674-452f-aa21-cdc05cb164d8\\scratchpad\\dk\\examples"}}
ull, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Write audit event", "fontSize": 11, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Write audit event", "autoResize": true, "lineHeight": 1.25}, {"type": "text", "id": "title", "x": 0, "y": 10, "width": 1462.8600000000001, "height": 28, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "User login with token refresh", "fontSize": 20, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "User login with token refresh", "autoResize": true, "lineHeight": 1.25}, {"type": "text", "id": "sub", "x": 0, "y": 44, "width": 1462.8600000000001, "height": 18, "angle": 0, "strokeColor": "#555555", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Password login, optional MFA challenge, short-lived access token and refresh rotation", "fontSize": 12, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Password login, optional MFA challenge, short-lived access token and refresh rotation", "autoResize": true, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}, "diagramkit": {"kind": "seq", "spec": {"name": "login-sequence", "title": "User login with token refresh", "subtitle": "Password login, optional MFA challenge, short-lived access token and refresh rotation", "participants": [{"id": "usr", "label": "User\n(Browser)", "color": "blue"}, {"id": "web", "label": "Web App", "color": "blue"}, {"id": "api", "label": "API Gateway", "color": "green"}, {"id": "auth", "label": "Auth Service", "color": "green"}, {"id": "mfa", "label": "MFA Provider", "color": "purple"}, {"id": "db", "label": "User Database", "color": "orange"}], "steps": [{"divider": "1. Password login"}, "usr->web: Submit email + password", "web->api: POST /login", "api->auth: Verify credentials", "auth->db: Load user + password hash", "db-->auth: User record", {"note": "Compare with slow hash (argon2id);\nrate limit per account and per IP", "over": "auth"}, {"frame": "alt  MFA enabled for this user", "steps": ["auth->mfa: Send challenge", "mfa-->usr: One-time code (SMS / app)", "usr->web: Enter code", "web->api: POST /login/mfa", "api->auth: Verify code", "auth->mfa: Validate code", "mfa-->auth: valid"]}, "auth-->api: Access token (15 min) + refresh token", "api-->web: 200 + Set-Cookie (HttpOnly)", "web-->usr: Signed in", {"divider": "2. Token refresh"}, {"frame": "loop  access token expires", "steps": ["web->api: POST /refresh (refresh cookie)", "api->auth: Rotate refresh token", "auth->db: Store new token, revoke old", "auth-->api: New access + refresh token", "api-->web: 200", {"frame": "alt  refresh token reused (theft)", "steps": ["auth->db: Revoke token family", "auth-->web: 401, sign in again"]}, {"note": "Reuse of a rotated token revokes the whole family", "over": ["auth", "db"], "color": "red"}]}, {"divider": "3. Self call"}, "auth->auth: Write audit event"]}, "base_dir": "D:\\00_Work\\Graphic\\diagram-kit\\examples"}}
server"}, {"id": "payments", "zone": "platform", "label": "Payment\nService", "icon": "builtin:payment"}, {"id": "psp", "zone": "external", "label": "Payment provider", "color": "gray", "icon": "builtin:cloud"}, {"id": "mail", "zone": "external", "label": "Email / SMS gateway", "color": "gray", "dashed": true, "icon": "builtin:mail"}, {"id": "console", "zone": "ops", "label": "Admin console", "icon": "builtin:settings"}, {"id": "mon", "zone": "ops", "label": "Metrics and alerting", "icon": "builtin:chart"}, {"id": "cache", "zone": "data", "label": "Redis\ncart, sessions", "icon": "builtin:cache"}, {"id": "bus", "zone": "data", "label": "Message queue\norder events", "icon": "builtin:queue"}, {"id": "pg", "zone": "data", "label": "PostgreSQL\norders, stock", "icon": "builtin:database"}], "edges": ["shopper->web: browse", {"edge": "shopper->mobile: use", "from_side": "left", "to_side": "left"}, "web->gw: HTTPS", "mobile->gw: HTTPS", "gw->orders: checkout", "gw->catalog: search", "orders->inventory: reserve", "orders->payments: charge", "payments->psp: authorize", "orders->pg: persist", "catalog->cache: cache", "orders->bus: OrderPlaced", "bus-->mail: notify", "console->gw: admin API", "mon-->pg: metrics"], "legend": {"blue": "Client side", "green": "Platform services", "purple": "Data and messaging", "orange": "Operations", "gray": "External / actors"}}, "base_dir": "D:\\00_Work\\Graphic\\diagram-kit\\examples"}}
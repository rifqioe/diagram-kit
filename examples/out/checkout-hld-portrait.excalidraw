"}, {"id": "web", "zone": "clients", "label": "Web storefront\n(SPA)", "icon": "builtin:browser"}, {"id": "mobile", "zone": "clients", "label": "Mobile app", "icon": "builtin:mobile"}, {"id": "gw", "zone": "platform", "label": "NGINX API Gateway (TLS, auth, rate limit)", "colspan": 4, "icon": "logos/nginx.svg"}, {"id": "catalog", "zone": "platform", "label": "Catalog\nService", "icon": "builtin:server"}, {"id": "inventory", "zone": "platform", "label": "Inventory\nService", "icon": "builtin:server"}, {"id": "orders", "zone": "platform", "label": "Order\nService", "icon": "builtin:server"}, {"id": "payments", "zone": "platform", "label": "Payment\nService", "icon": "builtin:payment"}, {"id": "psp", "zone": "external", "label": "Payment provider", "color": "gray", "icon": "builtin:cloud"}, {"id": "mail", "zone": "external", "label": "Email / SMS gateway", "color": "gray", "dashed": true, "icon": "builtin:mail"}, {"id": "console", "zone": "ops", "label": "Admin console", "icon": "builtin:settings"}, {"id": "mon", "zone": "ops", "label": "Prometheus\nmetrics, alerts", "icon": "logos/prometheus.svg"}, {"id": "cache", "zone": "data", "label": "Redis\ncart, sessions", "icon": "logos/redis.svg"}, {"id": "bus", "zone": "data", "label": "Apache Kafka\norder events", "icon": "logos/apachekafka.svg"}, {"id": "pg", "zone": "data", "label": "PostgreSQL\norders, stock", "icon": "logos/postgresql.svg"}], "edges": ["shopper->web: browse", {"edge": "shopper->mobile: use", "from_side": "left", "to_side": "left"}, "web->gw: HTTPS", "mobile->gw: HTTPS", "gw->orders: checkout", "gw->catalog: search", "orders->inventory: reserve", "orders->payments: charge", "payments->psp: authorize", "orders->pg: persist", "catalog->cache: cache", "orders->bus: OrderPlaced", "bus-->mail: notify", "console->gw: admin API", "mon-->pg: metrics"], "legend": {"blue": "Client side", "green": "Platform services", "purple": "Data and messaging", "orange": "Operations", "gray": "External / actors"}}, "base_dir":